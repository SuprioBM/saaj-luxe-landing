# Copy to .env and fill in — see docs/IMPLEMENTATION_PROGRESS.md and docs/HANDOFF.md.
# .env is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# CLIENT-SAFE — bundled into the browser JS. Never put a secret behind VITE_*.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Canonical app URL — single source of truth for every auth redirect (Google
# OAuth, email confirm, password reset) and the bKash callback URL. Change
# this one line when you move from localhost to a real domain. No trailing
# slash. Read client-side via import.meta.env and server-side via
# process.env (Vite exposes VITE_*-prefixed vars to both).
VITE_SITE_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# SERVER-ONLY — read via process.env in server functions / SSR. Same Supabase
# project as above, just not prefixed with VITE_ so Vite won't bundle it.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Privileged — bypasses RLS. Server-only. NEVER expose to the client bundle,
# never prefix with VITE_, never log it.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Direct Postgres connection — migrations / CLI / db tooling only. The app
# itself never reads this at runtime.
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# ---------------------------------------------------------------------------
# bKash (payment gateway, online payment only) — server-only. Tokenized
# Checkout (URL based) API, v1.2.0-beta. bKash has no public sandbox
# credentials — you must be onboarded as a sandbox merchant by bKash
# (https://developer.bka.sh/) to get these four values before Online
# Payment works, even in development. Cash on Delivery works with no
# configuration at all.
# ---------------------------------------------------------------------------
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_MODE="sandbox"
# Optional — overrides the sandbox/live base URL BKASH_MODE picks by
# default. Leave unset unless bKash gives you a different base URL.
BKASH_BASE_URL=""
# The bKash callback URL is built from VITE_SITE_URL above (bare, no query
# string — see src/lib/payments/bkash.ts) — nothing extra to set here. It
# must be reachable from the internet (a tunnel, or your deployed URL) for
# bKash to redirect back to it; plain localhost only works if you're testing
# by hand in the same browser that's also running the dev server.

# ---------------------------------------------------------------------------
# Transactional email (Gmail SMTP via an App Password) — server-only.
# Generate at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification enabled on the Google account first). If left unset, emails
# are skipped (logged, never thrown) — checkout/cancellation still work.
# ---------------------------------------------------------------------------
SMTP_USER=""
SMTP_APP_PASSWORD=""
SMTP_FROM_NAME="SAAJ"

# ---------------------------------------------------------------------------
# SAAJ AI Commerce Agent (LangChain + LangGraph) — server-only.
# The LLM provider is replaceable: any OpenAI-compatible /chat/completions
# endpoint works. Default is Groq. AGENT_API_KEY may be ONE key or a
# comma-separated list (one is chosen at random per request to spread rate
# limits). Without a key the chat bubble still renders but every message
# returns a friendly "assistant unavailable" — nothing else breaks.
# ---------------------------------------------------------------------------
AGENT_API_KEY=""            # falls back to GROQ_API_KEY / OPENAI_API_KEY
GROQ_API_KEY=""             # gsk_... (or "gsk_a,gsk_b,gsk_c" for rotation)
AGENT_BASE_URL="https://api.groq.com/openai/v1"
AGENT_MODEL="openai/gpt-oss-120b"
# AGENT_TEMPERATURE="0.3"
# AGENT_MAX_STEPS="5"        # max tool-call rounds per turn
# AGENT_HISTORY_WINDOW="16"  # prior messages replayed as context
